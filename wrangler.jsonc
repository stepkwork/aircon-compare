{
  "name": "aircon-compare",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aircon-compare",
      "database_id": "a278f507-a749-4def-8977-43cfe449260b"
    }
  ]
}
